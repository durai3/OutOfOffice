# Never bake secrets or local runtime state into the image. Config comes in
# at `docker run` time via --env-file / -e; runtime state comes in via the
# /data volume (see docker/README.md). A build that includes .env would ship
# whoever's local Gmail password, API keys, and Telegram bot token to
# anyone who gets the image - this was a real bug caught by testing (2026-09-23).
.env
.env.*
!.env.example

# Local runtime data: rebuilt/regenerated at runtime, or supplied via the
# mounted /data volume - never baked in. This also matters for privacy: a
# locally-signed-in Chrome profile here is as sensitive as a password.
data/

# Python virtual env and caches - irrelevant once requirements.txt is
# reinstalled fresh inside the image.
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# The Next.js web console is a separate app the Python worker never runs.
web/

# Version control and editor/OS noise.
.git/
.gitignore
.vscode/
.idea/
.DS_Store

# Tests aren't needed at runtime; keep the image lean.
tests/
