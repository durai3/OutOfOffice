# DELEG8 - runtime configuration.
# Copy to `.env` and adjust. Values marked (required for X) enable that
# feature; without them the rest of the system still runs.
#
# DELEG8 serves many accounts from one deployment. Read this file as
# *deployment* settings: the database, the shared bot, the platform's own API
# keys and their quotas, how meetings are run. Everything that belongs to one
# user - their Representation Policy, their documents, their notification
# channel, their own API keys - lives in the database and is edited in the
# console, not here.

# --- API server ---
DELEG8_HOST=127.0.0.1
DELEG8_PORT=8000
DELEG8_LOG_LEVEL=INFO
# Base URL the verification scripts target - also this server's own
# externally-reachable URL, used to build each OAuth connector's redirect_uri
# (src/api/integrations.py). Must be the exact URL registered with each
# provider below; a provider rejects any redirect_uri that doesn't match
# byte-for-byte. Local development needs a tunnel (ngrok, cloudflared, ...)
# pointed at this server for any OAuth connector to be reachable at all.
DELEG8_BASE_URL=http://127.0.0.1:8000

# --- Telegram escalation bridge ---
# One bot serves every account. Telegram allows exactly one poller per token,
# so the server runs a single hub (src/escalation/hub.py) and routes each
# update to a tenant by chat id; users connect theirs by sending `/link <code>`
# from the console's Settings page. A user who would rather not share the
# operator's bot can supply their own token in Settings instead.
#
# (required for escalation) Token from @BotFather, e.g. 123456789:AAF...xyz
TELEGRAM_BOT_TOKEN=
# Only used by the single-user CLI path (`python -m src.main join` outside a
# dispatched container) and by tests/test_escalation.py. The server ignores it:
# a chat id in a config file cannot be the answer for more than one customer.
TELEGRAM_CHAT_ID=
# Seconds to wait for a button tap before the delegate defers. A user may
# override this for their own account in Settings.
ESCALATION_TIMEOUT_SECONDS=30

# --- Connector OAuth apps (src/integrations/) ---
# One app per provider, registered once by this deployment's operator -
# exactly the same shape as the Telegram bot above: every account on this
# deployment connects through the same app, and a connector with no
# credentials set here simply shows as "not available" in the console
# (src/integrations/oauth.py: OAuthConnector.is_available) rather than
# pretending to work. Register each app's redirect URI as exactly
# {DELEG8_BASE_URL}/api/v1/integrations/{type}/oauth/callback, e.g.
# http://127.0.0.1:8000/api/v1/integrations/google_calendar/oauth/callback.
#
# Slack, Microsoft Teams, and Email (Resend) need none of this - they connect
# with a pasted webhook URL or API key straight from the console.
#
# (optional) Google Cloud Console -> APIs & Services -> Credentials -> OAuth
# client ID (type: Web application). Enable the Google Calendar API first.
# Reused as-is by src/calendar/providers.py: connecting a Google mailbox for
# meeting auto-detection (possibly several, on top of however the user signed
# in) is the same OAuth app with a couple more scopes, not a second one.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# (optional) src/calendar/providers.py: connect an Outlook/Microsoft 365
# mailbox for meeting auto-detection. Implemented and ready, but not the
# active path yet - leave unset until an app is registered for it; it will
# simply show as "not available" in the console until then, the same as
# Jira/Linear/Asana/Notion below. Microsoft Entra admin center -> App
# registrations -> New registration -> "Accounts in any organizational
# directory and personal Microsoft accounts" -> API permissions -> add
# Calendars.Read (delegated) -> Certificates & secrets -> New client secret.
# Redirect URI: {DELEG8_BASE_URL}/api/v1/calendar/accounts/microsoft/oauth/callback
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
# (optional) https://developer.atlassian.com/console/myapps/ -> OAuth 2.0 (3LO)
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
# (optional) https://linear.app/settings/api/applications
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
# (optional) https://app.asana.com/0/developer-console
ASANA_CLIENT_ID=
ASANA_CLIENT_SECRET=

# --- "Continue with Google / Microsoft" sign-in (src/auth/oauth_identity.py) ---
# Separate OAuth app registrations from GOOGLE_CALENDAR_CLIENT_ID above, on
# purpose: a login button must never silently carry Calendar-scope consent,
# and rotating or revoking the login app must never break anyone's calendar
# sync. Register each app's redirect URI as exactly
# {DELEG8_BASE_URL}/api/v1/auth/oauth/{provider}/callback, e.g.
# http://127.0.0.1:8000/api/v1/auth/oauth/google/callback. Leaving either
# pair unset just hides that provider's button - email/password still works.
#
# (optional) Google Cloud Console -> APIs & Services -> Credentials -> OAuth
# client ID (type: Web application). Scopes requested: openid email profile.
GOOGLE_SSO_CLIENT_ID=
GOOGLE_SSO_CLIENT_SECRET=
# (optional) Microsoft Entra admin center -> App registrations -> New
# registration -> "Accounts in any organizational directory and personal
# Microsoft accounts" (this is what lets both individuals and companies sign
# in) -> Certificates & secrets -> New client secret.
MICROSOFT_SSO_CLIENT_ID=
MICROSOFT_SSO_CLIENT_SECRET=

# --- Voice pipeline ---
# (required for voice) Deepgram API key from https://console.deepgram.com
# The platform's key, used by any account that has not brought its own.
DEEPGRAM_API_KEY=
# (required for voice) Cartesia API key from https://play.cartesia.ai
CARTESIA_API_KEY=
# Optional voice tuning. Defaults shown.
DEEPGRAM_MODEL=nova-3
CARTESIA_MODEL_ID=sonic-3
# Leave empty to use the first voice in your Cartesia library (printed at startup).
# List voices with: python tests/test_voice_loop.py --list-voices
CARTESIA_VOICE_ID=
# The two virtual cables the delegate hears and speaks through. Prefer the
# NAMES over the indexes: PortAudio numbers devices by enumeration order, so an
# index silently comes to mean a different device as soon as one appears or
# disappears (an iPhone's Continuity microphone is enough to shift them all).
#   INPUT  = the bot's ears: the device the browser plays the meeting into
#   OUTPUT = the bot's mouth: the device the browser uses as its microphone
# They must be two DIFFERENT loopback devices - PortAudio cannot open one device
# as both, and the microphone then delivers nothing at all.
# Probe every cable and print the route: python -m src.audio.cable_check
DELEG8_INPUT_DEVICE_NAME=
DELEG8_OUTPUT_DEVICE_NAME=
DELEG8_INPUT_DEVICE_INDEX=
DELEG8_OUTPUT_DEVICE_INDEX=
# Before each call, play a tone into each cable and record it back, and swap in
# a working one if the configured cable is deaf. Leave this on: a cable whose
# driver is installed but never loaded opens without error and returns silence
# forever, which otherwise shows up only as a meeting the delegate sits mute
# through.
DELEG8_AUDIO_PREFLIGHT=true
# Point the system default output/input at the chosen cables, since that is what
# the browser plays into and records from.
DELEG8_AUDIO_AUTOROUTE=true
# Barge-in fires when the user says at least this many words while the bot talks.
DELEG8_BARGE_IN_MIN_WORDS=1
# true = mute the mic while the bot speaks (use on open speakers; disables barge-in).
DELEG8_HALF_DUPLEX=false
# Who the microphone represents in the meeting (must not be the principal).
DELEG8_VOICE_SPEAKER=Counterpart
DELEG8_VOICE_MEETING_ID=voice-session
# Deepgram endpointing: silence (ms) that finalises an utterance, and the backstop.
DELEG8_STT_ENDPOINTING_MS=300
DELEG8_STT_UTTERANCE_END_MS=1000

# --- Knowledge base (RAG) ---
# In the server these three are only the single-user CLI defaults. Each account
# gets its own documents folder and its own Chroma collection under
# DELEG8_TENANT_DIR (see below), derived from its account id - so no display
# name, email or slug can be crafted to collide with another tenant's index.
# The embedding model is shared across all of them; the collections are not.
DELEG8_DOCUMENTS_DIR=data/documents
DELEG8_CHROMA_DIR=data/chroma_db
DELEG8_RAG_COLLECTION=deleg8_documents
# CPU sentence-transformers model (downloaded from Hugging Face on first use).
DELEG8_EMBEDDING_MODEL=all-MiniLM-L6-v2
# Cosine similarity below which a query is flagged UNKNOWN_CONTEXT (0..1).
DELEG8_RAG_MIN_SIMILARITY=0.30
DELEG8_RAG_TOP_K=4
DELEG8_CHUNK_SIZE=800
DELEG8_CHUNK_OVERLAP=120

# --- Meeting memory and post-meeting briefing ---
# Rolling window of recent utterances kept in the live meeting state.
DELEG8_MEMORY_WINDOW=12

# --- The brain ---
# The delegate cannot think without one of these. Gemini (Google AI) is the
# default and leads when both are set; DELEG8_LLM_PROVIDER=claude flips that. Every model id lives in src/llm.py, with a fallback chain per role, so
# a retired or briefly overloaded model does not take the delegate down with it.
#
# Model ids DO get retired. When one does, the provider answers 404 and the old
# code silently degraded to a deterministic fallback - the delegate kept talking
# and was wrong for a whole meeting. That cannot happen quietly now: a liveness
# check runs at startup and the delegate refuses to join a call with a dead brain.
# These are the PLATFORM's keys: every account that has not brought its own
# spends them, metered per user and bounded by the plan in src/usage/meter.py.
# A user who adds their own key in Settings goes out on theirs instead, and
# their usage stops counting against the allowance.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# gemini | claude | auto (auto = Gemini first, Claude if there is no Gemini key)
# DELEG8_LLM_PROVIDER=auto

# (optional) Override the primary model for either role. FAST sits in the live
# turn loop (latency is the product); SMART compiles the dossier and writes the
# briefing off the critical path. A named model goes to the head of its chain.
# DELEG8_ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001
# DELEG8_ANTHROPIC_SMART_MODEL=claude-sonnet-5
# DELEG8_GEMINI_FAST_MODEL=gemini-3.6-flash
# DELEG8_GEMINI_SMART_MODEL=gemini-3.6-flash

# Refuse to fall back to non-LLM behaviour at all. Off by default so a transient
# outage cannot cost you a live meeting; turn it on in development and CI, where
# a silent fallback is a bug you want to see immediately.
# DELEG8_STRICT_LLM=false

# Let the delegate join a meeting even when the startup liveness check failed.
# Only for demos without a key - it will be unable to answer anything.
# DELEG8_ALLOW_NO_LLM=false

# --- Meeting platform bot (Google Meet / Zoom / Microsoft Teams) ---
# Set exactly one of these three to the meeting link - the platform is
# detected from the URL itself, so nothing else here needs to change between
# them. If more than one is set, MEET_JOIN_URL wins, then ZOOM_JOIN_URL, then
# TEAMS_JOIN_URL (matches the order below). A link passed to `--url` on the
# CLI, or in the web console's dispatch form, overrides all three.
MEET_JOIN_URL=
ZOOM_JOIN_URL=
TEAMS_JOIN_URL=

# (optional) Throwaway accounts for the bot, one per platform - leave a pair
# empty to join that platform as a guest (fine for most external meetings;
# Zoom and Teams meetings that restrict entry to signed-in accounts need one).
BOT_GOOGLE_EMAIL=
BOT_GOOGLE_PASSWORD=
BOT_ZOOM_EMAIL=
BOT_ZOOM_PASSWORD=
BOT_TEAMS_EMAIL=
BOT_TEAMS_PASSWORD=

# Shared across every platform:
# Name shown in the participant list (guest joins; signed-in bots show the account name).
BOT_DISPLAY_NAME=DELEG8
# false = Chromium opens a window. Headless Chromium has NO audio devices, so keep it false for real calls
# (locally or in the containerised worker in docker/ - Xvfb there gives Chromium a display, not headless mode).
BOT_HEADLESS=false
# Persistent Chromium profile so a signed-in session survives restarts. Each
# platform gets its own subfolder automatically unless overridden below.
BOT_CHROME_PROFILE_DIR=data/chrome_profile
# BOT_ZOOM_PROFILE_DIR=data/chrome_profile_zoom
# BOT_TEAMS_PROFILE_DIR=data/chrome_profile_teams
BOT_SCREENSHOT_DIR=data/screenshots
# Seconds to wait for the host to admit the bot from the lobby/waiting room.
BOT_LOBBY_TIMEOUT_SECONDS=300
# When sign-in is blocked or challenged, wait this long for you to finish it in the window (0 = fail fast).
BOT_MANUAL_LOGIN_SECONDS=0
# Health-check cadence and rejoin attempts after a dropped connection.
BOT_HEALTH_INTERVAL_SECONDS=5
BOT_REJOIN_ATTEMPTS=2
# (optional, Google Meet only) Device names to pick inside Meet's own audio settings; empty = system defaults.
BOT_MEET_MIC_NAME=
BOT_MEET_SPEAKER_NAME=

# (containerised worker only - set by docker/entrypoint.sh, not normally by
# hand) Routes the Chromium *subprocess*'s audio to the virtual devices the
# entrypoint created, separately from this process's own PULSE_SINK/PULSE_SOURCE.
# See src/gateway/bot_base.py's "Container audio routing" section.
# BOT_CHROMIUM_PULSE_SINK=
# BOT_CHROMIUM_PULSE_SOURCE=

# --- Web console ---
# Browser origins allowed to call the API (the Next.js dev server). Comma-separated.
DELEG8_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Largest single document the Knowledge page accepts, in megabytes.
DELEG8_UPLOAD_MAX_MB=25
# Single-user CLI paths only; the server keeps policies and briefs in Postgres.
DELEG8_PROFILES_DIR=data/profiles
DELEG8_HISTORY_DIR=data/history


# --------------------------------------------------------------------------- #
# Multi-tenancy
# --------------------------------------------------------------------------- #

# --- Database ---
# Postgres holds users, principals, policies, meetings, commitments, documents,
# usage and the consent audit trail. Leave it unset and a local SQLite file is
# used instead: fine for a laptop, not a deployment target, and the health page
# says so out loud.
#
#   docker run -d --name deleg8-db -e POSTGRES_USER=deleg8 \
#     -e POSTGRES_PASSWORD=deleg8 -e POSTGRES_DB=deleg8 \
#     -p 55432:5432 -v deleg8_pgdata:/var/lib/postgresql/data postgres:16-alpine
DATABASE_URL=postgresql+psycopg://deleg8:deleg8@127.0.0.1:55432/deleg8
# DELEG8_DB_POOL_SIZE=10
# DELEG8_DB_MAX_OVERFLOW=20

# --- Secrets (required in production) ---
# Generate each with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Signs access tokens. Rotating it signs everyone out.
DELEG8_SECRET_KEY=
# Encrypts users' own API keys and bot tokens at rest. Separate from the signing
# key on purpose: rotating one must not invalidate the other. Rotating THIS one
# makes every stored key unreadable and users must re-enter them.
DELEG8_ENCRYPTION_KEY=
# development | production. In production the server refuses to start on
# derived development secrets rather than quietly using them.
DELEG8_ENV=development
# How long an access token lasts, and how long a refresh token stays valid.
# DELEG8_ACCESS_TOKEN_MINUTES=60
# DELEG8_REFRESH_TOKEN_DAYS=30

# --- Per-tenant storage ---
# One directory per account: its documents, its screenshots, its own vector
# index. This whole directory is what gets bind-mounted into that account's
# worker containers as /data - which is how a worker can reach its own tenant's
# index and no one else's.
DELEG8_TENANT_DIR=data/tenants

# --- Dispatch ---
# Where a meeting actually runs.
#   container - one deleg8-worker container per meeting, per user. The shipping
#               path: separate Chromium, separate audio devices, separate
#               address space, so two meetings genuinely run at once.
#   inprocess - an asyncio task in this server. Development only; every session
#               fights over one machine's default audio devices.
#   auto      - container when Docker is usable, in-process otherwise (default).
DELEG8_DISPATCH_MODE=auto
DELEG8_WORKER_IMAGE=deleg8-worker:latest
# Build it with:  docker build -f docker/Dockerfile -t deleg8-worker:latest .

# Where worker containers reach this server to fetch their tenant bundle, post
# events, and relay escalations. host.docker.internal is correct on Docker
# Desktop; on Linux set this to the address the container can actually reach.
DELEG8_CALLBACK_URL=http://host.docker.internal:8000
# Deployment-wide ceiling on concurrent meetings, on top of each plan's own cap.
DELEG8_MAX_CONCURRENT_MEETINGS=8
# A meeting is a browser plus two audio pipelines; the 64 MB default /dev/shm
# makes Chromium fall over in a way that looks like a join failure.
DELEG8_WORKER_SHM=1g
# DELEG8_WORKER_MEMORY=2g
# DELEG8_WORKER_CPUS=2
# DELEG8_WORKER_NETWORK=

# --- Recording consent ---
# The default for new accounts; each user sets their own in Settings and may
# override it per meeting.
#   notify_only  - announce the delegate and that it transcribes, then take part
#   all_party    - announce, then retain NOTHING until someone in the room
#                  agrees. Required in all-party consent jurisdictions.
#   single_party - same behaviour as notify_only, recorded under a single-party
#                  legal basis so the audit trail says which was claimed.
DELEG8_CONSENT_MODE=notify_only
# How long the room has to answer in all-party mode before the delegate
# announces it will not transcribe and leaves.
DELEG8_CONSENT_TIMEOUT_SECONDS=90

# --- Instant demo accounts (hackathon judges / evaluators) ---
# POST /api/v1/auth/demo creates a throwaway account on the small "demo" plan,
# so an evaluator reaches the product without signing up. Ordinary signup and
# sign-in are untouched. Set to 0 to switch the button off.
DELEG8_DEMO_ENABLED=1
# Guest accounts one client address may create per hour.
DELEG8_DEMO_PER_IP_HOUR=30

# --- Briefing -> Google Docs (optional) ---
# Makes "Open in Google Docs" create a real, pre-filled Doc. Deploy
# deploy/google-docs-export.gs as an Apps Script web app (steps are in the file),
# then paste its /exec URL and the SECRET you set there. Unset = the button falls
# back to copy-and-paste.
DELEG8_GDOC_WEBAPP_URL=
DELEG8_GDOC_WEBAPP_SECRET=
