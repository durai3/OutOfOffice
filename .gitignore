.venv/
__pycache__/
*.pyc
.env
.pytest_cache/
# start.sh server logs
.backend.log
.frontend.log
# Local vector store (rebuild with: python -m src.knowledge.ingest)
data/chroma_db/
# Chromium profile (holds the bot's Google session) and diagnostics
data/chrome_profile/
data/screenshots/
# Archived meeting briefs (runtime data; the Representation Policy in data/profiles/ is kept)
data/history/
# Frontend build artefacts (web/.gitignore covers the rest)
web/node_modules/
web/.next/
# Per-tenant runtime data: every account's documents, vector index, screenshots
# and browser profile. Never committed - this is customer data.
data/tenants/
# Local SQLite fallback when DATABASE_URL is unset (development only).
data/deleg8.db
data/deleg8.db-*
# Personal documents and the dossier compiled from them (CVs, transcripts, cover letters).
# Kept on disk for the single-user CLI and its evals; never committed. The committed
# sample knowledge base lives in demo/documents/ and is fictional.
data/documents/*.pdf
data/dossier/
